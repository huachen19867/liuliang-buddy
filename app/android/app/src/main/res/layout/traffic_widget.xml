<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_shell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingBottom="5dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="流量小伙伴"
            android:textColor="#34405A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点我刷新 ›"
            android:textColor="#74819A"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/mobile_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="7dp"
            android:background="@drawable/widget_mobile_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="中国移动"
                    android:textColor="#386EAD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/mobile_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#6F7F91"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/mobile_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#3374BC"
                android:textSize="21sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/mobile_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="通用剩余"
                android:textColor="#5C7190"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/mobile_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#77849A"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_divider"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:text="" />

        <LinearLayout
            android:id="@+id/broadnet_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="7dp"
            android:background="@drawable/widget_broadnet_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="中国广电"
                    android:textColor="#BD6B6A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/broadnet_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#927A7A"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/broadnet_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#C97973"
                android:textSize="21sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/broadnet_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="通用剩余"
                android:textColor="#927574"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/broadnet_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#A08A88"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="先在应用里选择运营商"
            android:textColor="#74819A"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
