<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_shell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingBottom="5dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="流量小伙伴"
            android:textColor="#34405A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_refresh_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点我刷新 ›"
            android:textColor="#74819A"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:contentDescription="打开流量小伙伴并刷新所选运营商"
            android:clickable="true"
            android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_carrier_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/slot_1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运营商"
                    android:textColor="#386EAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/slot_1_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#6F7F91"
                    android:textSize="8sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/slot_1_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#3374BC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="余额待确认"
                android:textColor="#5C7190"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_1_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#77849A"
                android:textSize="8sp"
                android:maxLines="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/top_divider"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_carrier_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/slot_2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运营商"
                    android:textColor="#386EAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/slot_2_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#6F7F91"
                    android:textSize="8sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/slot_2_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#3374BC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="余额待确认"
                android:textColor="#5C7190"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_2_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#77849A"
                android:textSize="8sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_carrier_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/slot_3_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运营商"
                    android:textColor="#386EAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/slot_3_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#6F7F91"
                    android:textSize="8sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/slot_3_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#3374BC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="余额待确认"
                android:textColor="#5C7190"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_3_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#77849A"
                android:textSize="8sp"
                android:maxLines="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/bottom_divider"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/slot_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_carrier_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/slot_4_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运营商"
                    android:textColor="#386EAD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/slot_4_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="#6F7F91"
                    android:textSize="8sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/slot_4_amount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="—"
                android:textColor="#3374BC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_4_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="余额待确认"
                android:textColor="#5C7190"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/slot_4_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚无查询时间"
                android:textColor="#77849A"
                android:textSize="8sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="先在应用里选择运营商"
        android:textColor="#74819A"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
